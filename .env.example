# URL pública do site (usada em SEO, sitemap e Open Graph) — domínio oficial a confirmar
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Destinatário das mensagens dos formulários (cotação, contato, currículos)
FORMS_TO_EMAIL=
# Remetente autorizado no provedor (ex.: "EMS Logística <site@seudominio.com.br>")
FORMS_FROM_EMAIL=

# Opção A — Resend (https://resend.com)
RESEND_API_KEY=

# Opção B — SMTP (Hostinger, Locaweb, Google Workspace, etc.)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
